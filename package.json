{
  "name": "konrad-gourmet-backend",
  "version": "0.1.0",
  "description": "Backend de Konrad Gourmet: menús, pedidos, inventario y compras (Node.js, PostgreSQL en Supabase, EDA + Facade, Factory Method, Adapter y Outbox)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "start:cron": "node cron/worker.js",
    "admin:crear": "node scripts/crearAdministrador.js",
    "db:schema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f src/infrastructure/database/schema.sql",
    "test": "node tests/ejecutar.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19"
  }
}
