# Imagen de los procesos automáticos (cron) de Konrad Gourmet
FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# El cron reutiliza el dominio y la infraestructura de src/ (misma composición que la API)
COPY src ./src
COPY cron ./cron

USER node

# El worker escribe un latido cada minuto; si tiene más de 3 minutos, el contenedor se marca no saludable
HEALTHCHECK --interval=60s --timeout=5s --start-period=40s --retries=3 \
  CMD ["node", "-e", "const f=require('os').tmpdir()+'/kg-cron-latido';process.exit(Date.now()-require('fs').statSync(f).mtimeMs<180000?0:1)"]

CMD ["node", "cron/worker.js"]
