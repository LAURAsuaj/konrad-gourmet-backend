# ============================================================
# Konrad Gourmet - Variables de entorno
# Copie este archivo a .env y complete los valores.
# NUNCA versione el archivo .env (CO-6: credenciales fuera del código).
# ============================================================

NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# ---------- TLS 1.3 (CO-6) ----------
# En producción debe ser TLSv1.3
TLS_MIN_VERSION=TLSv1.3
# Certificado CA de Supabase (opcional, con saltos de línea escritos como \n)
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true
# Solo desarrollo local con Postgres sin TLS; en producción debe ser true
DB_SSL=true

# TLS del servidor (CO-6). En producción use UNA de las dos opciones:
#  a) la API termina TLS 1.3: indique el certificado y la llave (rutas de archivo)
#  b) un proxy/balanceador termina TLS 1.3 delante de la API: TRUST_PROXY=true
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
TRUST_PROXY=false
# Intentos de login fallidos permitidos dentro de la ventana (minutos):
# por cuenta desde un mismo equipo, y en total por equipo (IP)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_MAX_IP=100
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# ---------- Base de datos (Supabase / PostgreSQL) ----------
# Cadena de conexión: Supabase -> botón Connect -> "Session pooler" (puerto 5432).
# NO use la conexión directa (db.xxxx.supabase.co): solo responde por IPv6 y desde muchas
# redes da "connection timeout". Con el pooler el usuario es postgres.PROYECTO (no solo postgres).
# Si la contraseña tiene símbolos (@ # / : %), codifíquelos o use una solo con letras y números.
DATABASE_URL=postgresql://postgres.PROYECTO:CAMBIAR@aws-0-REGION.pooler.supabase.com:5432/postgres
# Conexiones máximas de cada proceso (API y cron cuentan por separado); no supere el límite del pooler
DB_POOL_MAX=10
# Debe empezar por https:// y no terminar con "/"
SUPABASE_URL=https://PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CAMBIAR

# ---------- Autenticación (CU-01) ----------
# Mínimo 32 caracteres
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO_DE_32_O_MAS
JWT_EXPIRES_IN=30m
JWT_ISSUER=konrad-gourmet
BCRYPT_ROUNDS=12

# ---------- Outbox / EDA ----------
OUTBOX_POLL_MS=2000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_RETRY_BASE_SECONDS=15
OUTBOX_LEASE_SECONDS=60

# ---------- Procesos automáticos (cron) ----------
CRON_TIMEZONE=America/Bogota
# La hora del descuento diario se parametriza en BD (parametro.hora_descuento_diario);
# esta expresión solo se usa como valor de respaldo.
CRON_DESCUENTO_FALLBACK=0 2 * * *
CRON_TENDENCIAS=0 8 * * 1
CRON_REINTENTO_PRECIOS=*/30 * * * *

# ---------- Ministerio de Comercio: servicio SOAP de precios (CU-10) ----------
# Dirección del servicio SOAP 1.2 con el contrato de SIPSA (DANE). En desarrollo: el simulador
# (node scripts/mockServicios.js) en http://127.0.0.1:4010/sipsaWS/SrvSipsaUpraBeanService
MINCOMERCIO_API_URL=
# Espera máxima (ms) sin recibir datos. El servicio real del DANE tarda ~17 s en empezar a responder
MINCOMERCIO_TIMEOUT_MS=60000
# Días de precios que se leen (contados desde el dato más reciente). El servicio entrega todo su
# historial (más de 20 MB) del más nuevo al más antiguo; el sistema corta la lectura al salir de la ventana
MINCOMERCIO_VENTANA_DIAS=14
# Ciudad de la que se toma el precio (vacío = promedio de todas las ciudades)
MINCOMERCIO_CIUDAD=
# true solo si el servicio real únicamente responde por http:// (excepción al HTTPS obligatorio)
MINCOMERCIO_PERMITIR_HTTP=false
# Minutos que se conserva en memoria la tabla de precios antes de pedirla de nuevo
MINCOMERCIO_CACHE_MINUTOS=360

# ---------- Correo electrónico (CU-05, CU-07, CU-09, CU-15) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=Konrad Gourmet <no-reply@konradgourmet.com>

# ---------- Redes sociales (CU-15) ----------
REDES_API_URL=
REDES_API_TOKEN=
REDES_TIMEOUT_MS=8000
