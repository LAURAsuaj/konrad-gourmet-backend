# Imagen de la API de Konrad Gourmet (Node.js)
FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

# Solo dependencias de producción (capa cacheable mientras no cambie package*.json)
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Código de la API y script de alta del primer administrador
COPY src ./src
COPY scripts ./scripts

# Sin privilegios de root
USER node
EXPOSE 3000

# /salud verifica también la conexión a la base de datos; usa HTTPS si la API termina TLS
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "const m=require(process.env.HTTPS_CERT_PATH?'https':'http');m.get({host:'127.0.0.1',port:process.env.PORT||3000,path:'/salud',rejectUnauthorized:false},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]

CMD ["node", "src/app.js"]
